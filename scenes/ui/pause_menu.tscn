[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/pause_menu.gd" id="1_script"]
[ext_resource type="Theme" path="res://assets/themes/lunar_theme.tres" id="2_theme"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1_script")

[node name="Overlay" type="Control" parent="."]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme = ExtResource("2_theme")

[node name="Scrim" type="ColorRect" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.01, 0.02, 0.025, 0.82)

[node name="Center" type="CenterContainer" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Card" type="PanelContainer" parent="Overlay/Center"]
custom_minimum_size = Vector2(400, 0)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Overlay/Center/Card"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Overlay/Center/Card/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Пауза"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Overlay/Center/Card/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
text = "Продолжить"

[node name="MainMenuButton" type="Button" parent="Overlay/Center/Card/Content"]
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
text = "В главное меню"

[connection signal="button_down" from="Overlay/Center/Card/Content/ResumeButton" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="Overlay/Center/Card/Content/MainMenuButton" to="." method="_on_main_menu_pressed"]
