[node name="Center" type="CenterContainer" parent="Margin"]
layout_mode = 2

[node name="Card" type="PanelContainer" parent="Margin/Center"]
custom_minimum_size = Vector2(440, 0)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Margin/Center/Card"]
layout_mode = 2
